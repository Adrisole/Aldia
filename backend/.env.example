DATABASE_URL="postgresql://aldia:aldia@localhost:5432/aldia"
JWT_SECRET="change-me-in-production"
PORT=3000
REDIS_URL="redis://localhost:6379"

# Cifrado en reposo de los tokens de Mercado Pago (AES-256-GCM, §8 de la spec)
ENCRYPTION_KEY="change-me-in-production"

# App de Mercado Pago (developers.mercadopago.com -> tu aplicación)
MP_CLIENT_ID=""
MP_CLIENT_SECRET=""
MP_REDIRECT_URI="http://localhost:3000/mp/oauth/callback"
# Firma el "state" del flujo OAuth para que nadie conecte una cuenta MP sobre otro tenant
MP_OAUTH_STATE_SECRET="change-me-in-production"
# Base pública del backend, para armar la notification_url de las preferencias de pago
PUBLIC_BASE_URL="http://localhost:3000"
# A dónde volver tras el callback de OAuth
FRONTEND_URL="http://localhost:5173"
# Secreto de firma del webhook (dashboard de MP -> tu aplicación -> Webhooks)
MP_WEBHOOK_SECRET=""
